# ===== Server =====
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ===== PostgreSQL (FR-06, NFR-15) =====
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_exam_assistant
PGHOST=localhost
PGPORT=5432
PGDATABASE=ai_exam_assistant
PGUSER=postgres
PGPASSWORD=postgres

# ===== Auth (NFR-07, NFR-08) =====
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ===== AI Provider abstraction (NFR-17) =====
AI_PROVIDER=groq

GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=openai/gpt-oss-20b

OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-1.5-pro

# ===== File uploads (FR-08) =====
MAX_UPLOAD_MB=10
